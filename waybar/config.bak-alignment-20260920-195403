{
    // -------------------------------------------------------------------------
    // Global configuration
    // -------------------------------------------------------------------------

    "layer": "top",

    "position": "top",

    "height": 32,
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,

    "spacing": 5, // Gaps between modules (4px)

    "modules-left": [
        "ext/workspaces",
        "cpu",
        "memory",
        "custom/storage"
    ],
    "modules-center": [
        "clock#date",
        "custom/weather"
    ],
    "modules-right": [
        "battery",
        "wireplumber",
        "hyprland/language",
        "tray",
        "custom/screenshot_t",
        "custom/power"
    ],


    // -------------------------------------------------------------------------
    // Modules
    // -------------------------------------------------------------------------

    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-he": "HE"
    },

    "custom/screenshot_t": {
        "format": "<span size='145%'></span>",
        "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/screenshot_full\"",
        "on-click-right": "\"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/screenshot_area\""
    },

    "memory": {
        "interval": 30,
        "format": "<span size='145%'></span>  {percentage}%",
        "on-click": "kitty -e btop"
    },

    "battery": {
        "interval": 2,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "<span size='145%'></span> {capacity}%",
        "format-plugged": "<span size='145%'></span> {capacity}%",
        "format-icons": [
            "<span size='145%'></span>",
            "<span size='145%'></span>",
            "<span size='145%'></span>",
            "<span size='145%'></span>",
            "<span size='145%'></span>"
        ]
    },

    "custom/weather": {
        "format": "{}",
        "format-alt": "{alt}: {}",
        "format-alt-click": "click-right",
        "interval": 3600,
        "exec": "curl -s 'https://wttr.in/?format=1'",
        "exec-if": "ping wttr.in -c1"
    },

    "custom/power": {
        "format": " <span size='145%'>󰐥</span> ",
        "tooltip": false,
        "on-click": "wlogout"
    },

    "clock#date": {
        "format": "<span size='145%'>󰥔</span>  {:%H:%M  %e %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "today-format": "<b>{}</b>"
    },

    "cpu": {
        "interval": 1,
        "format": "<span size='145%'></span>  {usage}%",
        "max-length": 20
    },

    "ext/workspaces": {
        "all-outputs": false,
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'",
        "sort-by-name": true,
        "on-click": "activate",
        "ignore-hidden": false,
        "active-only": false
    },

    "wireplumber": {
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "format": "<span foreground='#d8ad70'>{icon}</span>  {volume}%",
        "format-muted": "<span size='145%'></span> ",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "<span size='145%'></span> ",
            "hands-free": "<span size='145%'></span> ",
            "headset": "<span size='145%'></span> ",
            "phone": "<span size='145%'></span> ",
            "portable": "<span size='145%'></span> ",
            "car": "<span size='145%'></span> ",
            "default": ["<span size='145%'></span> ", "<span size='145%'></span> ", "<span size='145%'></span> "]
        },
    },


    "custom/storage": {
        "format": "<span size='145%'></span>  {}",
        "return-type": "json",
        "interval": 30,
        "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/modules/storage.sh\"",
        "exec-if": "[ -f \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/modules/storage.sh\" ]"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 5
    }
}
