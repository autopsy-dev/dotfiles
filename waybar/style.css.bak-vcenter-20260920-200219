@import './colors.css';

* {
    font-family: "Noto Sans Mono", "FontAwesome", sans-serif;
    font-size: 14px;
    font-weight: 600;
    min-height: 0;
    text-shadow: none;
}

window#waybar {
    background: rgba(16, 28, 36, 0.92);
    color: @text;
    border: 1px solid alpha(@sage, 0.30);
    border-radius: 12px;
}
window#waybar.hidden { opacity: 0.5; }
tooltip {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 10px;
}
tooltip label { color: @text; }

#workspaces { padding: 3px 6px; }
#workspaces button {
    color: @muted;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    min-width: 24px;
    padding: 0 2px;
    margin: 0 2px;
    box-shadow: none;
    text-shadow: none;
    transition: background-color 160ms ease, color 160ms ease;
}
#workspaces button.active, #workspaces button.focused {
    color: @amber;
    background: @forest;
    border-color: alpha(@amber, 0.45);
}
#workspaces button:hover { background: @surface; color: @text; }
#workspaces button.urgent { color: @red; border-color: @red; }

#clock, #cpu, #memory, #disk, #battery, #network, #wireplumber,
#pulseaudio, #temperature, #tray, #custom-storage, #custom-weather,
#custom-screenshot_t, #custom-power { padding: 0 8px; }
#custom-screenshot_t, #custom-power { min-width: 20px; }
#language { padding: 0 8px; color: @muted; }
#clock { color: @text; }
#cpu, #memory, #custom-storage { color: @sage; }
#wireplumber, #custom-power { color: @amber; }
#custom-weather, #custom-screenshot_t { color: @teal; }
#battery.warning { color: @amber; }
#battery.critical:not(.charging), #temperature.critical { color: @red; }
#tray { padding: 0 8px; }
#pulseaudio-slider slider, #backlight-slider slider {
    min-width: 0; min-height: 0; opacity: 0;
    background-image: none; border: none; box-shadow: none;
}
#pulseaudio-slider trough, #backlight-slider trough {
    min-width: 80px; min-height: 8px; border-radius: 4px; background: @surface;
}
#pulseaudio-slider highlight, #backlight-slider highlight {
    min-height: 8px; border-radius: 4px; background: @amber;
}
