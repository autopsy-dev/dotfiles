#!/usr/bin/env python3
"""Read-only check; package names vary between distributions."""
import shutil
import subprocess

groups = {
    "Desktop": "Hyprland hyprctl python3 waybar swaybg kitty thunar rofi mako wlogout wpctl",
    "Lock and idle": "swaylock swayidle",
    "Screenshots": "grim slurp wl-copy xdg-user-dir notify-send",
    "Laptop brightness": "brightnessctl",
    "Extras": "playerctl nm-applet sunsetr pavucontrol btop",
}
for group, commands in groups.items():
    missing = [command for command in commands.split() if not shutil.which(command)]
    print(f"{group}: " + ("missing " + ", ".join(missing) if missing else "OK"))
if shutil.which("Hyprland"):
    result = subprocess.run(["Hyprland", "--version"], capture_output=True, text=True)
    print("\n" + (result.stdout or result.stderr).splitlines()[0])
print("Requires the Lua configuration API; tested on Hyprland 0.56.2.")
